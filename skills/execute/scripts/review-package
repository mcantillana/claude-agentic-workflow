#!/usr/bin/env bash
# Arma el paquete de review: lista de commits, resumen de archivos y el diff
# neto con contexto extendido, en un archivo que el revisor lee de una sola
# vez. Usar el BASE registrado por tarea (nunca HEAD~1) mantiene enteras las
# tareas de varios commits.
#
# Uso: review-package PLAN_FILE BASE HEAD [OUTFILE]
# OUTFILE por defecto: <workspace>/review-<base7>..<head7>.diff
# (nombrado por rango, para que un re-review tras los fixes tenga archivo
# propio y fresco).
set -euo pipefail

if [ $# -lt 3 ] || [ $# -gt 4 ]; then
  echo "uso: review-package PLAN_FILE BASE HEAD [OUTFILE]" >&2
  exit 2
fi

plan=$1
base=$2
head=$3
[ -f "$plan" ] || { echo "no existe el plan: $plan" >&2; exit 2; }

git rev-parse --verify --quiet "$base" >/dev/null || { echo "BASE invalido: $base" >&2; exit 2; }
git rev-parse --verify --quiet "$head" >/dev/null || { echo "HEAD invalido: $head" >&2; exit 2; }

if [ $# -eq 4 ]; then
  out=$4
else
  dir=$("$(cd "$(dirname "$0")" && pwd)/workspace" "$plan")
  out="$dir/review-$(git rev-parse --short "$base")..$(git rev-parse --short "$head").diff"
fi

{
  echo "# Paquete de review: ${base}..${head}"
  echo
  echo "## Commits"
  git log --oneline "${base}..${head}"
  echo
  echo "## Archivos cambiados"
  git diff --stat "${base}..${head}"
  echo
  echo "## Diff"
  git diff -U10 "${base}..${head}"
} > "$out"

commits=$(git rev-list --count "${base}..${head}")
echo "escrito ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
